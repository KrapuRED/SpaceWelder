  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f76979030708087499bb79b741f4489a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  captianDialogueBox: {fileID: 0}
  standardDialogueBox: {fileID: 0}
  storyData:
    clientName: "Helix Biotech Logistics \u2014 Procurement Director Elian Voss"
    cargo: Medical Cryo-Containers
    storyDialogueDatas:
    - characterName: Elian Voss
      charType: 2
      dialogueData:
        dialogueName: 
        dialogueID: 
        dialogue: Captain Rhea, confirm transport of twelve medical cryo-containers
          to Outpost K-12.
    - characterName: Captain Rhea
      charType: 1
      dialogueData:
        dialogueName: 
        dialogueID: 
        dialogue: Cargo secured. Departure ready.
    - characterName: Elian Voss
      charType: 2
      dialogueData:
        dialogueName: 
        dialogueID: 
        dialogue: "The colony\u2019s medical reserves are nearly exhausted. We expect
          an on-time delivery."
    - characterName: Captain Rhea
      charType: 1
      dialogueData:
        dialogueName: 
        dialogueID: 
        dialogue: "You\u2019ll get your shipment."
    - characterName: Elian Voss
      charType: 2
      dialogueData:
        dialogueName: 
        dialogueID: 
        dialogue: Our system flagged your vessel for repeated maintenance delays.
    - characterName: Captain Rhea
      charType: 1
      dialogueData:
        dialogueName: 
        dialogueID: 
        dialogue: Ship still flies.
    - characterName: Elian Voss
      charType: 2
      dialogueData:
        dialogueName: 
        dialogueID: 
        dialogue: For both our sakes, make sure it keeps flying.
