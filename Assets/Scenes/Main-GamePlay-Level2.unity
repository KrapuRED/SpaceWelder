--- !u!114 &1739373959787487033
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3799879939785634434}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 727cbd5a69e7aa6479bb2c941b450f43, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _missionControlDialogues:
  - NameMissionControlData: Mission Control Start
    MissionControlDataType: 0
    MissionControlDialogueData:
    - activeAt: 0
      dialogueData:
        dialogueName: 
        dialogueID: 
        dialogue: Weldbot-42, systems online. Keep this hull together and we make
          it in time!.
  - NameMissionControlData: Mission Control Efficiency
    MissionControlDataType: 1
    MissionControlDialogueData:
    - activeAt: 100
      dialogueData:
        dialogueName: 
        dialogueID: MCED-00
        dialogue: Hull integrity stable. Ship efficiency holding perfectly.
    - activeAt: 99
      dialogueData:
        dialogueName: 
        dialogueID: MCED-01
        dialogue: Minor hull damage detected. Patch it before efficiency drops further!
    - activeAt: 60
      dialogueData:
        dialogueName: 
        dialogueID: MCED-02
        dialogue: Efficiency is falling fast. Structural damage is affecting propulsion.
    - activeAt: 40
      dialogueData:
        dialogueName: 
        dialogueID: MCED-03
        dialogue: "Hull condition critical. If this keeps up, we won\u2019t make
          the deadline."
    - activeAt: 0
      dialogueData:
        dialogueName: 
        dialogueID: MCED-04
        dialogue: "e\u2019re losing too much speed\u2026 fix those breaches NOW!"
  - NameMissionControlData: Mission Control Destination
    MissionControlDataType: 2
    MissionControlDialogueData:
    - activeAt: 50
      dialogueData:
        dialogueName: 
        dialogueID: MCDD-00
        dialogue: alfway there. Stay focused, Weldbot.
    - activeAt: 90
      dialogueData:
        dialogueName: 
        dialogueID: MCDD-01
        dialogue: Almost there. Hold this ship together a little longer.
  - NameMissionControlData: Mission Control PLayer Status
    MissionControlDataType: 3
    MissionControlDialogueData:
    - activeAt: 60
      dialogueData:
        dialogueName: 
        dialogueID: MCPD-00
        dialogue: Careful, Weldbot-42. I still need you operational.
    - activeAt: 30
      dialogueData:
        dialogueName: 
        dialogueID: MCPD-01
        dialogue: "Don\u2019t shut down on me now\u2026"
  _InactiveTalking: 10
  _isActive: 1
  _lockedTimeout: 15
  _shipManager: {fileID: 0}
  _destinationManager: {fileID: 0}
  _currentPlayer: {fileID: 0}
